{
  "name": "nba-dashboard-clone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:edge-functions": "npx -y deno cache --no-check supabase/functions/*/index.ts",
    "typecheck:edge-functions": "npx -y deno check --config supabase/deno.json supabase/functions/*/index.ts",
    "typecheck": "npm run typecheck:edge-functions",
    "lint": "eslint .",
    "assets:upload-referees": "node scripts/upload-referee-full-assets.mjs",
    "test": "node --test \"src/**/*.test.js\"",
    "test:edge": "npx -y deno test --config supabase/deno.json supabase/functions/**/*.test.ts",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm test && npm run test:edge && npm run typecheck && npm run test:e2e && npm run build && npm audit --audit-level=high",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-query": "^5.59.0",
    "date-fns": "^3.6.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^6.30.4",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "vite": "^8.1.0"
  }
}
